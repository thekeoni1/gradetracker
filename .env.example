# Copy to .env, which is gitignored.

# Hamilton's Blackboard host, no trailing slash.
BB_BASE_URL=https://blackboard.hamilton.edu

# Cheap authenticated endpoint the launcher polls and `gt status` checks.
# Swap this after real recon if public endpoints reject cookie auth.
BB_CHECK_PATH=/learn/api/public/v1/users/me

# Browser for the login window. Leave unset for Playwright's bundled
# Chromium; set to 'chrome' if the SSO provider flags it.
# BB_BROWSER_CHANNEL=chrome

# Gradescope login email. The password lives in the OS keychain, never here.
GS_EMAIL=

# Optional exact Gradescope term, e.g. Fall 2026. Leave unset to sync the
# newest term found in your course list.
# GS_TERM=

# Where the database, raw dumps and browser profile live. Defaults to
# %LOCALAPPDATA%\GradeTracker, deliberately outside this folder: the project
# may sit in OneDrive, which would sync session tokens to the cloud and lock
# the browser profile's SQLite mid-sync. Only set this if you want it elsewhere.
# GT_DATA_DIR=
